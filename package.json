{
  "name": "violet-void-theme_chatgpt",
  "version": "1.0.0",
  "description": "Dark Violet-Void theme for ChatGPT.",
  "author": "aaronedev",
  "license": "MIT",
  "homepage": "https://github.com/aaronedev/violet-void-theme_chatgpt",
  "repository": {
    "type": "git",
    "url": "https://github.com/aaronedev/violet-void-theme.git"
  },
  "userStyle": {
    "namespace": "github.com/aaronedev/violet-void-theme_chatgpt",
    "version": "5.4.1"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "verify:artifact": "node scripts/verify-artifact.js",
    "lint": "stylelint \"src/**/*.css\" \"chatgpt-violet-void.user.css\"",
    "test:unit": "node --test tests/*.test.js",
    "test": "npm run test:unit && playwright test",
    "dev:browser": "npm run build && node scripts/dev-browser.js",
    "setup:stylus": "node scripts/setup-stylus.js",
    "dev:browser:setup": "npm run setup:stylus && npm run dev:browser",
    "check": "npm run build && npm run verify:artifact && npm run lint && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.6.2",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended": "^17.0.0",
    "yauzl": "^3.2.0"
  }
}
